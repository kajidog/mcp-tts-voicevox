{
  "name": "@kajidog/player-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Audio player UI for MCP TTS Voicevox using MCP Apps Extension",
  "main": "./dist/mcp-app.html",
  "exports": {
    ".": "./dist/mcp-app.html"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:dev": "NODE_ENV=development vite build",
    "watch": "vite build --watch",
    "dev": "vite",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@kajidog/voicevox-client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
